# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave both blank to run in local demo mode (data stays in this browser).
VITE_SUPABASE_URL=
# The anon/publishable key is designed to be public; row-level security protects the data.
# Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=
# Optional, comma-separated: google,apple — only after enabling them in Supabase Auth.
VITE_AUTH_PROVIDERS=
